{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "13623495639613251793"
    },
    "description": "Chroma 1.5.9 on Azure Container Apps, with the data on Azure Files SMB, scale to zero and backups with Azure Backup."
  },
  "parameters": {
    "name": {
      "type": "string",
      "defaultValue": "chroma",
      "minLength": 2,
      "maxLength": 20,
      "metadata": {
        "description": "Name of the container app, and prefix of the other resources: 2 to 20 lowercase letters, digits and hyphens."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region of the resources."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/chroma-core/chroma:1.5.9",
      "metadata": {
        "description": "Image of the server. Chroma 1.5.9; the same image is on Docker Hub as chromadb/chroma."
      }
    },
    "access": {
      "type": "string",
      "defaultValue": "allowed-ips",
      "allowedValues": [
        "allowed-ips",
        "internal"
      ],
      "metadata": {
        "description": "Who reaches the server: allowed-ips (HTTPS from the allowed IP ranges) or internal (only apps in the same Container Apps environment). Chroma 1.5.9 has no API keys, so the server is never open to everyone."
      }
    },
    "allowedIpRanges": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "IP ranges, in CIDR notation, that may reach the server over HTTPS when access is allowed-ips."
      }
    },
    "cpu": {
      "type": "string",
      "defaultValue": "0.5",
      "metadata": {
        "description": "CPU cores of the replica: 0.5 with 1Gi of memory, or 1.0 with 2Gi."
      }
    },
    "memory": {
      "type": "string",
      "defaultValue": "1Gi",
      "metadata": {
        "description": "Memory of the replica."
      }
    },
    "logRetentionDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 30,
      "maxValue": 730,
      "metadata": {
        "description": "Days of logs in Log Analytics."
      }
    },
    "backup": {
      "type": "string",
      "defaultValue": "files",
      "allowedValues": [
        "files",
        "none"
      ],
      "metadata": {
        "description": "Backups of the file share: files (Azure Backup, snapshots of the share in its storage account) or none."
      }
    },
    "backupEveryHours": {
      "type": "int",
      "defaultValue": 24,
      "allowedValues": [
        4,
        6,
        8,
        12,
        24
      ],
      "metadata": {
        "description": "Hours between two backups of the file share."
      }
    },
    "backupRetentionDays": {
      "type": "int",
      "defaultValue": 7,
      "minValue": 1,
      "maxValue": 200,
      "metadata": {
        "description": "Days a backup is kept. A share keeps at most 200 snapshots: up to 200 days with a backup every 24 hours, 99 every 12, 65 every 8, 49 every 6 and 32 every 4."
      }
    },
    "backupAlreadyOn": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "true on a new deployment of this template when its backups are already on: the share stays protected as it is, and only the schedule and the days kept are applied again. Without it, a new deployment protects the share again, and Azure Backup reports one of its two configure jobs as failed. Never true on the first deployment: the share would not be protected."
      }
    }
  },
  "variables": {
    "backupsPerDay": "[div(24, parameters('backupEveryHours'))]",
    "backupMaxDays": "[if(equals(parameters('backupEveryHours'), 24), 200, sub(div(200, variables('backupsPerDay')), 1))]",
    "checks": [
      "[if(and(equals(parameters('access'), 'allowed-ips'), empty(parameters('allowedIpRanges'))), fail('access allowed-ips needs at least one range in allowedIpRanges.'), 'ok')]",
      "[if(and(equals(parameters('backup'), 'files'), greater(parameters('backupRetentionDays'), variables('backupMaxDays'))), fail(format('With a backup every {0} hours, backupRetentionDays can be at most {1}: a share keeps at most 200 snapshots.', parameters('backupEveryHours'), variables('backupMaxDays'))), 'ok')]"
    ],
    "suffix": "[uniqueString(resourceGroup().id, parameters('name'))]",
    "backupFabric": "Azure",
    "backupManagementType": "AzureStorage",
    "backupRunTimes": [
      "2020-01-01T02:00:00Z"
    ]
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', parameters('name'))]",
      "location": "[parameters('location')]",
      "tags": {
        "parameter-checks": "[join(variables('checks'), ' ')]"
      },
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": "[parameters('logRetentionDays')]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2024-01-01",
      "name": "[format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)), 'default')]",
      "properties": {
        "shareDeleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}/{2}', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)), 'default', 'data')]",
      "properties": {
        "enabledProtocols": "SMB",
        "accessTier": "TransactionOptimized",
        "shareQuota": 100
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)), 'default')]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2026-01-01",
      "name": "[format('{0}-env', parameters('name'))]",
      "location": "[parameters('location')]",
      "properties": {
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ],
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name')))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2026-01-01",
      "name": "[format('{0}/{1}', format('{0}-env', parameters('name')), 'data')]",
      "properties": {
        "azureFile": {
          "accountName": "[format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))), '2024-01-01').keys[0].value]",
          "shareName": "data",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)))]",
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)), 'default', 'data')]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2026-01-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "copy": [
              {
                "name": "ipSecurityRestrictions",
                "count": "[length(parameters('allowedIpRanges'))]",
                "input": {
                  "name": "[format('allowed-{0}', copyIndex('ipSecurityRestrictions'))]",
                  "action": "Allow",
                  "ipAddressRange": "[parameters('allowedIpRanges')[copyIndex('ipSecurityRestrictions')]]"
                }
              }
            ],
            "external": "[equals(parameters('access'), 'allowed-ips')]",
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "chroma",
              "image": "[parameters('image')]",
              "command": [
                "dumb-init",
                "--",
                "sh",
                "-c",
                "exec 9>>/lock/.lock; echo \"waiting for the lock\"; flock 9; echo \"lock taken\"; exec chroma run /config.yaml"
              ],
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "volumeMounts": [
                {
                  "volumeName": "data",
                  "mountPath": "/data",
                  "subPath": "chroma"
                },
                {
                  "volumeName": "lock",
                  "mountPath": "/lock"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/api/v2/heartbeat",
                    "port": 8000
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 60
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/api/v2/heartbeat",
                    "port": 8000
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1
          },
          "volumes": [
            {
              "name": "data",
              "storageType": "AzureFile",
              "storageName": "data",
              "mountOptions": "nobrl"
            },
            {
              "name": "lock",
              "storageType": "AzureFile",
              "storageName": "data"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-env', parameters('name')), 'data')]"
      ]
    },
    {
      "condition": "[equals(parameters('backup'), 'files')]",
      "type": "Microsoft.RecoveryServices/vaults",
      "apiVersion": "2021-12-01",
      "name": "[format('{0}-backup', parameters('name'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "RS0",
        "tier": "Standard"
      },
      "properties": {}
    },
    {
      "condition": "[equals(parameters('backup'), 'files')]",
      "type": "Microsoft.RecoveryServices/vaults/backupPolicies",
      "apiVersion": "2022-02-01",
      "name": "[format('{0}/{1}', format('{0}-backup', parameters('name')), 'data-share')]",
      "properties": {
        "backupManagementType": "[variables('backupManagementType')]",
        "schedulePolicy": "[if(equals(parameters('backupEveryHours'), 24), createObject('schedulePolicyType', 'SimpleSchedulePolicy', 'scheduleRunFrequency', 'Daily', 'scheduleRunTimes', variables('backupRunTimes')), createObject('schedulePolicyType', 'SimpleSchedulePolicy', 'scheduleRunFrequency', 'Hourly', 'scheduleRunTimes', variables('backupRunTimes'), 'hourlySchedule', createObject('interval', parameters('backupEveryHours'), 'scheduleWindowStartTime', '2020-01-01T02:00:00.000Z', 'scheduleWindowDuration', sub(24, parameters('backupEveryHours')))))]",
        "retentionPolicy": {
          "dailySchedule": {
            "retentionTimes": "[variables('backupRunTimes')]",
            "retentionDuration": {
              "count": "[parameters('backupRetentionDays')]",
              "durationType": "Days"
            }
          },
          "retentionPolicyType": "LongTermRetentionPolicy"
        },
        "timeZone": "UTC",
        "workLoadType": "AzureFileShare"
      },
      "dependsOn": [
        "[resourceId('Microsoft.RecoveryServices/vaults', format('{0}-backup', parameters('name')))]"
      ]
    },
    {
      "condition": "[and(equals(parameters('backup'), 'files'), not(parameters('backupAlreadyOn')))]",
      "type": "Microsoft.RecoveryServices/vaults/backupFabrics/protectionContainers",
      "apiVersion": "2021-12-01",
      "name": "[format('{0}/{1}/storagecontainer;Storage;{2};{3}', format('{0}-backup', parameters('name')), variables('backupFabric'), resourceGroup().name, format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)))]",
      "properties": {
        "backupManagementType": "[variables('backupManagementType')]",
        "containerType": "StorageContainer",
        "sourceResourceId": "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)))]",
        "[resourceId('Microsoft.RecoveryServices/vaults/backupPolicies', format('{0}-backup', parameters('name')), 'data-share')]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)), 'default', 'data')]",
        "[resourceId('Microsoft.RecoveryServices/vaults', format('{0}-backup', parameters('name')))]"
      ]
    },
    {
      "condition": "[and(equals(parameters('backup'), 'files'), not(parameters('backupAlreadyOn')))]",
      "type": "Microsoft.RecoveryServices/vaults/backupFabrics/protectionContainers/protectedItems",
      "apiVersion": "2021-12-01",
      "name": "[format('{0}/{1}/{2}/{3}', split(format('{0}/{1}/storagecontainer;Storage;{2};{3}', format('{0}-backup', parameters('name')), variables('backupFabric'), resourceGroup().name, format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))), '/')[0], split(format('{0}/{1}/storagecontainer;Storage;{2};{3}', format('{0}-backup', parameters('name')), variables('backupFabric'), resourceGroup().name, format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))), '/')[1], split(format('{0}/{1}/storagecontainer;Storage;{2};{3}', format('{0}-backup', parameters('name')), variables('backupFabric'), resourceGroup().name, format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))), '/')[2], format('AzureFileShare;{0}', 'data'))]",
      "properties": {
        "protectedItemType": "AzureFileShareProtectedItem",
        "sourceResourceId": "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)))]",
        "policyId": "[resourceId('Microsoft.RecoveryServices/vaults/backupPolicies', format('{0}-backup', parameters('name')), 'data-share')]",
        "isInlineInquiry": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)))]",
        "[resourceId('Microsoft.RecoveryServices/vaults/backupFabrics/protectionContainers', split(format('{0}/{1}/storagecontainer;Storage;{2};{3}', format('{0}-backup', parameters('name')), variables('backupFabric'), resourceGroup().name, format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))), '/')[0], split(format('{0}/{1}/storagecontainer;Storage;{2};{3}', format('{0}-backup', parameters('name')), variables('backupFabric'), resourceGroup().name, format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))), '/')[1], split(format('{0}/{1}/storagecontainer;Storage;{2};{3}', format('{0}-backup', parameters('name')), variables('backupFabric'), resourceGroup().name, format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))), '/')[2])]",
        "[resourceId('Microsoft.RecoveryServices/vaults/backupPolicies', format('{0}-backup', parameters('name')), 'data-share')]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12)), 'default', 'data')]"
      ]
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "metadata": {
        "description": "Address for the clients. With internal access it answers only inside the Container Apps environment."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('name')), '2026-01-01').configuration.ingress.fqdn)]"
    },
    "storageAccount": {
      "type": "string",
      "value": "[format('st{0}{1}', take(replace(parameters('name'), '-', ''), 10), take(variables('suffix'), 12))]"
    },
    "image": {
      "type": "string",
      "value": "[parameters('image')]"
    }
  }
}