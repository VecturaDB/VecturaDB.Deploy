{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      {
        "name": "limits",
        "type": "Microsoft.Common.InfoBox",
        "options": {
          "style": "Warning",
          "text": "For a few hours of use a day. Each update needs a manual step, the first request after about 10 idle minutes waits about 30 seconds, and the server is slower than on a VM. Read the limits in the README before you deploy.",
          "uri": "https://github.com/VecturaDB/VecturaDB.Deploy/tree/main/azure/container-apps"
        }
      },
      {
        "name": "name",
        "type": "Microsoft.Common.TextBox",
        "label": "Name",
        "defaultValue": "chroma",
        "toolTip": "Name of the container app, and prefix of the other resources.",
        "constraints": {
          "required": true,
          "regex": "^[a-z][a-z0-9-]{0,18}[a-z0-9]$",
          "validationMessage": "2 to 20 lowercase letters, digits and hyphens, starting with a letter."
        }
      },
      {
        "name": "server",
        "type": "Microsoft.Common.TextBlock",
        "options": {
          "text": "Server: Chroma 1.5.9."
        }
      },
      {
        "name": "access",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Who reaches the server",
        "defaultValue": "These IP addresses, over HTTPS",
        "toolTip": "Chroma 1.5.9 has no API keys, so the server is never open to everyone.",
        "constraints": {
          "allowedValues": [
            {
              "label": "These IP addresses, over HTTPS",
              "value": "allowed-ips"
            },
            {
              "label": "Only apps in the same Container Apps environment",
              "value": "internal"
            }
          ],
          "required": true
        }
      },
      {
        "name": "ips",
        "type": "Microsoft.Common.TextBox",
        "label": "Allowed IP addresses",
        "toolTip": "IPv4 ranges in CIDR notation, separated by commas, like 203.0.113.10/32, 198.51.100.0/24.",
        "visible": "[equals(basics('access'), 'allowed-ips')]",
        "constraints": {
          "required": true,
          "regex": "^\\s*\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}(\\s*,\\s*\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2})*\\s*$",
          "validationMessage": "IPv4 ranges in CIDR notation, separated by commas."
        }
      }
    ],
    "steps": [
      {
        "name": "backups",
        "label": "Backups",
        "elements": [
          {
            "name": "backup",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "Backups of the file share",
            "defaultValue": "Yes, with Azure Backup",
            "toolTip": "Azure Backup bills the protected share every month, and Azure Files bills the snapshots. Take the backups while nobody writes: see Backups and restore in the README.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Yes, with Azure Backup",
                  "value": "files"
                },
                {
                  "label": "No",
                  "value": "none"
                }
              ],
              "required": true
            }
          },
          {
            "name": "backupEveryHours",
            "type": "Microsoft.Common.DropDown",
            "label": "A backup every",
            "defaultValue": "24 hours",
            "visible": "[equals(steps('backups').backup, 'files')]",
            "constraints": {
              "allowedValues": [
                {
                  "label": "4 hours",
                  "value": 4
                },
                {
                  "label": "6 hours",
                  "value": 6
                },
                {
                  "label": "8 hours",
                  "value": 8
                },
                {
                  "label": "12 hours",
                  "value": 12
                },
                {
                  "label": "24 hours",
                  "value": 24
                }
              ],
              "required": true
            }
          },
          {
            "name": "backupRetentionDays",
            "type": "Microsoft.Common.TextBox",
            "label": "Days a backup is kept",
            "defaultValue": "7",
            "toolTip": "A share keeps at most 200 snapshots: up to 200 days with a backup every 24 hours, 99 every 12, 65 every 8, 49 every 6 and 32 every 4.",
            "visible": "[equals(steps('backups').backup, 'files')]",
            "constraints": {
              "required": true,
              "regex": "^([1-9]|[1-9][0-9]|1[0-9][0-9]|200)$",
              "validationMessage": "From 1 to 200."
            }
          },
          {
            "name": "backupAlreadyOn",
            "type": "Microsoft.Common.CheckBox",
            "label": "The backups are already on: this is a new deployment of the template",
            "toolTip": "Tick it when you deploy the template again on a deployment with its backups on: the share stays protected as it is, and only the schedule and the days kept change. Never on the first deployment: the share would not be protected.",
            "visible": "[equals(steps('backups').backup, 'files')]"
          }
        ]
      },
      {
        "name": "advanced",
        "label": "Advanced",
        "elements": [
          {
            "name": "size",
            "type": "Microsoft.Common.DropDown",
            "label": "CPU and memory of the replica",
            "defaultValue": "0.5 CPU, 1 GiB",
            "constraints": {
              "allowedValues": [
                {
                  "label": "0.5 CPU, 1 GiB",
                  "value": "0.5|1Gi"
                },
                {
                  "label": "1 CPU, 2 GiB",
                  "value": "1.0|2Gi"
                }
              ],
              "required": true
            }
          },
          {
            "name": "logRetentionDays",
            "type": "Microsoft.Common.TextBox",
            "label": "Days of logs",
            "defaultValue": "30",
            "constraints": {
              "required": true,
              "regex": "^([3-9][0-9]|[1-6][0-9][0-9]|7[0-2][0-9]|730)$",
              "validationMessage": "From 30 to 730."
            }
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "name": "[basics('name')]",
      "access": "[basics('access')]",
      "allowedIpRanges": "[if(equals(basics('access'), 'allowed-ips'), split(replace(basics('ips'), ' ', ''), ','), parse('[]'))]",
      "cpu": "[first(split(steps('advanced').size, '|'))]",
      "memory": "[last(split(steps('advanced').size, '|'))]",
      "logRetentionDays": "[int(steps('advanced').logRetentionDays)]",
      "backup": "[steps('backups').backup]",
      "backupEveryHours": "[if(equals(steps('backups').backup, 'files'), steps('backups').backupEveryHours, 24)]",
      "backupRetentionDays": "[if(equals(steps('backups').backup, 'files'), int(steps('backups').backupRetentionDays), 7)]",
      "backupAlreadyOn": "[if(equals(steps('backups').backup, 'files'), steps('backups').backupAlreadyOn, false)]"
    }
  }
}
